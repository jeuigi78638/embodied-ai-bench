# ============================================================
# EAI-Bench · 具身智衡 — 环境变量模板
# 复制为 .env.local（本地开发）或填入 Vercel Environment Variables
# ============================================================

# ---- OpenAI（GPT-4o）--------------------------------------
# 获取：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Anthropic（Claude 3.5 Sonnet）-------------------------
# 获取：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- 豆包 / 火山引擎方舟（Ark）-----------------------------
# 获取：https://console.volcengine.com/ark  → API Key 管理
ARK_API_KEY=
# 豆包模型名（按你的账号可开通的模型填写，默认 1.5 Pro）
DOUBAO_MODEL=doubao-1-5-pro-32k-250115

# ---- DeepSeek ----------------------------------------------
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DeepSeek 模型名：deepseek-chat(V3) / deepseek-reasoner(R1)
DEEPSEEK_MODEL=deepseek-chat

# ---- 通义千问 / 阿里云百炼（DashScope）---------------------
# 获取：https://bailian.console.aliyun.com  → API-KEY
DASHSCOPE_API_KEY=

# ---- Gemini（Google）---------------------------------------
# 获取：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- GLM / 智谱开放平台 -------------------------------------
# 获取：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# ---- 站点可选配置 -------------------------------------------
# 站点名（用于页面标题）
NEXT_PUBLIC_SITE_NAME=具身智衡
# 所有模型的温度（0=更确定性，1=更有创意）
MODEL_TEMPERATURE=0.3
