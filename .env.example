# ============================================================
# EAI-Bench · 具身智衡 — 环境变量模板
# 复制为 .env.local（本地开发）或填入 Vercel Environment Variables
# ============================================================

# ---- OpenAI（GPT-4o）--------------------------------------
# 获取：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Anthropic（Claude 3.5 Sonnet）-------------------------
# 获取：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- 豆包 / 火山引擎方舟（Ark）-----------------------------
# 获取：https://console.volcengine.com/ark  → API Key 管理
ARK_API_KEY=
# 豆包模型名（按你的账号可开通的模型填写，默认 1.5 Pro）
DOUBAO_MODEL=doubao-1-5-pro-32k-250115

# ---- DeepSeek ----------------------------------------------
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DeepSeek 模型名：deepseek-chat(V3) / deepseek-reasoner(R1)
DEEPSEEK_MODEL=deepseek-chat

# ---- 通义千问 / 阿里云百炼（DashScope）---------------------
# 获取：https://bailian.console.aliyun.com  → API-KEY
DASHSCOPE_API_KEY=

# ---- Gemini（Google）---------------------------------------
# 获取：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- GLM / 智谱开放平台 -------------------------------------
# 获取：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# ---- 站点可选配置 -------------------------------------------
# 站点名（用于页面标题）
NEXT_PUBLIC_SITE_NAME=具身智衡
# 所有模型的温度（0=更确定性，1=更有创意）
MODEL_TEMPERATURE=0.3

# ---- 用户系统（P0：账号 + 数据上云）--------------------------
# 数据库连接串（Vercel Postgres / Neon）。在 Vercel 项目 Settings → Databases 创建 Postgres，
# 然后把连接串填到同名环境变量 DATABASE_URL。建表：执行 schema.sql。
DATABASE_URL=
# 会话签名密钥（务必改为随机长字符串，用于 JWT 签发）
AUTH_SECRET=change-me-to-a-long-random-string

# ---- 防护机制（lib/guard.ts，均有默认值，可按需调整）----------
# 单次对比最多模型数（默认 4）
MAX_MODELS_PER_CALL=4
# 单次评测最多任务数（默认 4）
MAX_TASKS_PER_CALL=4
# prompt 最大长度（字符，默认 3000）
MAX_PROMPT_LEN=3000
# 对比接口：单 IP 每分钟 / 每日次数上限
RL_COMPARE_PER_MIN=12
RL_COMPARE_PER_DAY=200
# 评测接口（成本高）：单 IP 每分钟 / 每日次数上限
RL_BENCH_PER_MIN=3
RL_BENCH_PER_DAY=30
